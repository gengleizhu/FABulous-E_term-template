@@ -44,6 +44,20 @@ def test_create_project(tmp_path: Path) -> None:
     )
 
 
+def test_create_project_includes_east_termination_tile(tmp_path: Path) -> None:
+    """Test that new projects can place and generate the `E_term` tile."""
+    project_dir = tmp_path / "test_project_e_term"
+    create_project(project_dir)
+
+    tile_dir = project_dir / "Tile" / "E_term"
+    assert (tile_dir / "E_term.csv").exists()
+    assert (tile_dir / "E_term_switch_matrix.list").exists()
+    assert (tile_dir / "gds_config.yaml").exists()
+
+    fabric_csv = (project_dir / "fabric.csv").read_text(encoding="utf-8")
+    assert "Tile,./Tile/E_term/E_term.csv" in fabric_csv
+
